# Tenderbuddy configuration. Copy to .env and edit. Never commit .env.
# Every value can also be set as a real environment variable.

# --- App ---
APP_NAME=Tenderbuddy
# development | test | production  (production refuses insecure defaults)
APP_ENV=development
HOST=0.0.0.0
PORT=8004
# SQLite for a single node; PostgreSQL for production:
#   postgresql+psycopg://tenderbuddy:CHANGE_ME@db:5432/tenderbuddy
DATABASE_URL=sqlite:///./data/tenderbuddy.db
DATA_DIR=./data
LOG_LEVEL=INFO
# json (production) | text (local)
LOG_FORMAT=text

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Defaults to true when APP_ENV=production. Set true whenever served over HTTPS.
# COOKIE_SECURE=true
# First admin, created only when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# --- Uploads ---
MAX_UPLOAD_MB=20

# --- Demo data (never in production) ---
SEED_DEMO_DATA=false

# --- Tender sources ---
# Comma-separated: ted, contracts_finder, sam_gov, csv
CONNECTORS=ted,contracts_finder,csv
# In-process scheduled sync every N minutes (0 = off; use `tenderbuddy sync` from cron instead).
SYNC_INTERVAL_MINUTES=0
SYNC_LOOKBACK_DAYS=7
SYNC_MAX_RECORDS=200
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
# TED filters (optional): ISO-3166 alpha-3 buyer countries and CPV code prefixes
TED_COUNTRIES=
TED_CPV_PREFIXES=
# SAM.gov needs a free personal key: SAM.gov -> Account Details -> Public API Key
SAM_API_KEY=
SAM_PTYPES=o,k
# CSV staging folder (default DATA_DIR/staging); files go in <dir>/<source>/*.csv
# CSV_STAGING_DIR=

# --- LLM (optional; everything works offline without it) ---
# auto = use the OpenAI-compatible API when LLM_BASE_URL is set, else offline mode
LLM_PROVIDER=auto
# Groq:       https://api.groq.com/openai/v1      (free tier)
# OpenRouter: https://openrouter.ai/api/v1         (free models)
# Ollama:     http://localhost:11434/v1             (local, no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=24000
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For/-Proto
# (the Docker image trusts only 127.0.0.1 by default). Set it to your proxy's address,
# e.g. 172.16.0.0/12 for a proxy container on the Compose network. Never use * when the
# app port is reachable directly: clients could spoof their IP and dodge the login rate limit.
FORWARDED_ALLOW_IPS=127.0.0.1
